font-size = 10
font-family = "Monaco"
font-feature = -liga
cursor-style = block

# window-height = 64
# window-width = 201
theme = Pierce-Special-1
window-padding-color = background
macos-titlebar-style = tabs
confirm-close-surface = false
shell-integration = detect
shell-integration-features = no-cursor,title
# macos-icon = custom-style
# macos-icon-ghost-color = #5BA8A1
# macos-icon-screen-color = #001015
# macos-icon-frame = chrome

# Keybindings
# keybind = super+right=next_tab
# keybind = super+left=previous_tab
# keybind = shift+super+p=toggle_quick_terminal

# For cmux compat
keybind = cmd+option+up=unbind
keybind = cmd+option+down=unbind
keybind = cmd+option+left=unbind
keybind = cmd+option+right=unbind
